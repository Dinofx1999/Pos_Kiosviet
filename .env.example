# ---- Database ----
DATABASE_URL=postgresql://erp:erp@localhost:5432/retail_erp?schema=public
DATABASE_URL_TEST=postgresql://erp:erp@localhost:5432/retail_erp_test?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=2000
# thư mục lưu ảnh sản phẩm (tương đối so với apps/api hoặc tuyệt đối)
UPLOAD_DIR=./uploads

# ---- Web ----
VITE_API_URL=http://localhost:3000/api/v1
