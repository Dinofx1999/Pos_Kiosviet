{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @erp/shared build && nest build",
    "dev": "pnpm --filter @erp/shared build && nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "pnpm --filter @erp/shared build && tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "jest --config jest.config.ts --selectProjects unit",
    "test:int": "jest --config jest.config.ts --selectProjects integration --runInBand --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "pnpm --filter @erp/shared build && ts-node prisma/seed.ts",
    "prisma:sync-roles": "ts-node prisma/sync-roles.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@erp/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.5.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jszip": "3.10.2",
    "nestjs-cls": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
