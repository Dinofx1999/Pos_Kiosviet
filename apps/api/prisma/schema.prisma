// Retail ERP – Prisma schema
// Conventions:
//  - Every tenant-scoped table has tenant_id + composite indexes starting with tenant_id.
//  - Money: Decimal(18,4). Quantity: Decimal(18,3). Never float.
//  - Posted documents are immutable; corrections happen through reversal/adjustment documents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// PLATFORM / TENANCY
// =====================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model Tenant {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(200)
  status        TenantStatus @default(TRIAL)
  planCode      String       @default("FREE") @map("plan_code") @db.VarChar(50)
  trialEndsAt   DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  planExpiresAt DateTime?    @map("plan_expires_at") @db.Timestamptz(6)
  planNote      String?      @map("plan_note") @db.VarChar(500)
  industry      String?      @db.VarChar(100)
  timezone      String       @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  currency      String       @default("VND") @db.VarChar(10)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings             TenantSetting[]
  branches             Branch[]
  warehouses           Warehouse[]
  users                User[]
  roles                Role[]
  documentSequences    DocumentSequence[]
  auditLogs            AuditLog[]
  idempotencyKeys      IdempotencyKey[]
  outboxEvents         OutboxEvent[]
  categories           ProductCategory[]
  brands               Brand[]
  units                Unit[]
  products             Product[]
  variants             ProductVariant[]
  priceBooks           PriceBook[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  stockReservations    StockReservation[]
  inventoryDocuments   InventoryDocument[]
  costLedgerEntries    CostLedgerEntry[]
  suppliers            Supplier[]
  partyBalances        PartyBalance[]
  partyLedgerEntries   PartyLedgerEntry[]
  payments             Payment[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReturns      PurchaseReturn[]
  customers            Customer[]
  shifts               Shift[]
  invoices             Invoice[]
  salesReturns         SalesReturn[]
  cashAccounts         CashAccount[]
  stockTransfers       StockTransfer[]
  stocktakes           Stocktake[]
  promotions           Promotion[]
  promotionVouchers    PromotionVoucher[]
  invoicePromotions    InvoicePromotion[]
  salesOrders          SalesOrder[]
  deliveries           Delivery[]
  importJobs           ImportJob[]
  integrations         IntegrationConnection[]
  pointEntries         CustomerPointEntry[]
  commissionRules      CommissionRule[]
  attendances          Attendance[]
  paymentCategories    PaymentCategory[]
  cashTransfers        CashTransfer[]
  cashReconciliations  CashReconciliation[]
  bankGatewayConfigs   BankGatewayConfig[]
  bankTransferRequests BankTransferRequest[]
  bankTransactions     BankTransaction[]

  @@map("tenants")
}

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

// =====================================================================
// ORGANISATION
// =====================================================================

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(200)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses           Warehouse[]
  userAccess           UserBranchAccess[]
  inventoryDocuments   InventoryDocument[]
  priceBookBranches    PriceBookBranch[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReturns      PurchaseReturn[]
  payments             Payment[]
  shifts               Shift[]
  invoices             Invoice[]
  salesReturns         SalesReturn[]
  cashAccounts         CashAccount[]
  transfersFrom        StockTransfer[]       @relation("TransferFromBranch")
  transfersTo          StockTransfer[]       @relation("TransferToBranch")
  stocktakes           Stocktake[]
  promotionBranches    PromotionBranch[]
  salesOrders          SalesOrder[]
  deliveries           Delivery[]
  bankTransferRequests BankTransferRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  address   String?  @db.VarChar(500)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch                @relation(fields: [branchId], references: [id])
  userAccess         UserWarehouseAccess[]
  balances           StockBalance[]
  movements          StockMovement[]
  reservations       StockReservation[]
  inventoryDocuments InventoryDocument[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  purchaseReturns    PurchaseReturn[]
  invoices           Invoice[]
  salesReturns       SalesReturn[]
  transfersFrom      StockTransfer[]       @relation("TransferFromWarehouse")
  transfersTo        StockTransfer[]       @relation("TransferToWarehouse")
  stocktakes         Stocktake[]
  salesOrders        SalesOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

// =====================================================================
// USERS / AUTH / RBAC
// =====================================================================

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  username     String     @db.VarChar(100)
  email        String?    @db.VarChar(200)
  phone        String?    @db.VarChar(30)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(200)
  status       UserStatus @default(ACTIVE)
  isOwner      Boolean    @default(false) @map("is_owner")
  allBranches  Boolean    @default(false) @map("all_branches")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  position     String?    @db.VarChar(100)
  hiredAt      DateTime?  @map("hired_at") @db.Date
  baseSalary   Decimal?   @map("base_salary") @db.Decimal(18, 4)
  employeeNote String?    @map("employee_note") @db.VarChar(1000)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                UserRole[]
  branchAccess         UserBranchAccess[]
  warehouseAccess      UserWarehouseAccess[]
  refreshTokens        RefreshToken[]
  loginHistory         LoginHistory[]
  commissionRules      CommissionRule[]
  attendances          Attendance[]
  shifts               Shift[]
  soldInvoices         Invoice[]             @relation("InvoiceSeller")
  bankTransferRequests BankTransferRequest[] @relation("BankRequestCreatedBy")

  @@unique([tenantId, username])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String @db.VarChar(100)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranchAccess {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
}

model UserWarehouseAccess {
  userId      String    @map("user_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouse_access")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  username  String   @db.VarChar(100)
  success   Boolean
  reason    String?  @db.VarChar(200)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("login_history")
}

// =====================================================================
// CROSS-CUTTING: AUDIT, NUMBERING, IDEMPOTENCY, OUTBOX
// =====================================================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  username   String?  @db.VarChar(100)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  entityCode String?  @map("entity_code") @db.VarChar(100)
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

enum SequenceResetPolicy {
  NEVER
  YEARLY
  MONTHLY
}

model DocumentSequence {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  docType     String              @map("doc_type") @db.VarChar(50)
  prefix      String              @db.VarChar(20)
  padding     Int                 @default(6)
  nextNumber  BigInt              @default(1) @map("next_number")
  resetPolicy SequenceResetPolicy @default(NEVER) @map("reset_policy")
  periodKey   String              @default("") @map("period_key") @db.VarChar(10)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, docType])
  @@map("document_sequences")
}

model IdempotencyKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  scope        String    @db.VarChar(200)
  key          String    @db.VarChar(200)
  requestHash  String    @map("request_hash") @db.VarChar(128)
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  lockedAt     DateTime  @default(now()) @map("locked_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

// =====================================================================
// PRODUCT MASTER
// =====================================================================

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

model ProductCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([tenantId, parentId])
  @@map("product_categories")
}

model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("units")
}

model Product {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  code           String      @db.VarChar(50)
  name           String      @db.VarChar(300)
  type           ProductType @default(GOODS)
  categoryId     String?     @map("category_id") @db.Uuid
  brandId        String?     @map("brand_id") @db.Uuid
  baseUnit       String?     @map("base_unit") @db.VarChar(50)
  description    String?
  taxRate        Decimal?    @map("tax_rate") @db.Decimal(5, 2)
  weight         Decimal?    @db.Decimal(12, 3)
  trackBatch     Boolean     @default(false) @map("track_batch")
  trackSerial    Boolean     @default(false) @map("track_serial")
  allowSale      Boolean     @default(true) @map("allow_sale")
  isActive       Boolean     @default(true) @map("is_active")
  hasVariants    Boolean     @default(false) @map("has_variants")
  attributeNames String[]    @default([]) @map("attribute_names")
  imageUrl       String?     @map("image_url") @db.VarChar(1000)
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  units      ProductUnit[]
  images     ProductImage[]
  comboItems ComboItem[]      @relation("ComboParent")

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, isActive, deletedAt])
  @@map("products")
}

model ProductVariant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  sku               String    @db.VarChar(80)
  barcode           String?   @db.VarChar(80)
  name              String    @db.VarChar(400)
  attributes        Json?
  sellPrice         Decimal   @default(0) @map("sell_price") @db.Decimal(18, 4)
  // costPrice = moving-average cost maintained ONLY by the inventory costing engine
  costPrice         Decimal   @default(0) @map("cost_price") @db.Decimal(18, 4)
  lastPurchasePrice Decimal?  @map("last_purchase_price") @db.Decimal(18, 4)
  // onHandTotal = tenant-wide on-hand (sum of balances), maintained transactionally with the ledger
  onHandTotal       Decimal   @default(0) @map("on_hand_total") @db.Decimal(18, 3)
  minStock          Decimal?  @map("min_stock") @db.Decimal(18, 3)
  maxStock          Decimal?  @map("max_stock") @db.Decimal(18, 3)
  weight            Decimal?  @db.Decimal(12, 3)
  imageUrl          String?   @map("image_url") @db.VarChar(1000)
  isDefault         Boolean   @default(false) @map("is_default")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product              Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches              ProductBatch[]
  images               ProductImage[]
  comboComponents      ComboItem[]             @relation("ComboComponent")
  priceBookItems       PriceBookItem[]
  balances             StockBalance[]
  movements            StockMovement[]
  reservations         StockReservation[]
  documentLines        InventoryDocumentLine[]
  costLedger           CostLedgerEntry[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  purchaseReturnLines  PurchaseReturnLine[]
  invoiceLines         InvoiceLine[]
  salesReturnLines     SalesReturnLine[]
  transferLines        StockTransferLine[]
  stocktakeLines       StocktakeLine[]
  salesOrderLines      SalesOrderLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@index([tenantId, name])
  @@map("product_variants")
}

/// Alternative selling/purchasing units. Stock is always tracked in the product base unit.
model ProductUnit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  unitName         String   @map("unit_name") @db.VarChar(50)
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(18, 6)
  sku              String?  @db.VarChar(80)
  barcode          String?  @db.VarChar(80)
  sellPrice        Decimal? @map("sell_price") @db.Decimal(18, 4)
  isDirectSale     Boolean  @default(true) @map("is_direct_sale")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, unitName])
  @@map("product_units")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String   @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@map("product_images")
}

model ComboItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  comboProductId     String  @map("combo_product_id") @db.Uuid
  componentVariantId String  @map("component_variant_id") @db.Uuid
  quantity           Decimal @db.Decimal(18, 3)

  comboProduct     Product        @relation("ComboParent", fields: [comboProductId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("ComboComponent", fields: [componentVariantId], references: [id])

  @@unique([comboProductId, componentVariantId])
  @@map("combo_items")
}

model ProductBatch {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  variantId  String    @map("variant_id") @db.Uuid
  batchNo    String    @map("batch_no") @db.VarChar(100)
  mfgDate    DateTime? @map("mfg_date") @db.Date
  expiryDate DateTime? @map("expiry_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  variant              ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  balances             StockBalance[]
  movements            StockMovement[]
  documentLines        InventoryDocumentLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  invoiceLines         InvoiceLine[]
  transferLines        StockTransferLine[]
  stocktakeLines       StocktakeLine[]
  salesOrderLines      SalesOrderLine[]

  @@unique([tenantId, variantId, batchNo])
  @@index([tenantId, expiryDate])
  @@map("product_batches")
}

// ---------------- Price books (Module 09 foundation) ----------------

enum PriceBookStatus {
  ACTIVE
  INACTIVE
}

model PriceBook {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  code           String          @db.VarChar(50)
