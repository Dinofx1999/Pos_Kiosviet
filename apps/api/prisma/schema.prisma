enum ShiftStatus {
  OPEN
  CLOSED
}

/// Ca bán hàng: one OPEN shift per cashier per branch; payments made while it is open carry shift_id for reconciliation.
model Shift {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  code         String      @db.VarChar(50)
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz(6)
  openingCash  Decimal     @default(0) @map("opening_cash") @db.Decimal(18, 4)
  expectedCash Decimal?    @map("expected_cash") @db.Decimal(18, 4)
  countedCash  Decimal?    @map("counted_cash") @db.Decimal(18, 4)
  difference   Decimal?    @db.Decimal(18, 4)
  note         String?     @db.VarChar(1000)
  closedById   String?     @map("closed_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]
  payments Payment[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, status])
  @@index([tenantId, userId, status])
  @@map("shifts")
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Invoice {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  warehouseId       String        @map("warehouse_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  shiftId           String?       @map("shift_id") @db.Uuid
  sellerId          String?       @map("seller_id") @db.Uuid
  priceBookId       String?       @map("price_book_id") @db.Uuid
  code              String        @db.VarChar(50)
  status            InvoiceStatus @default(DRAFT)
  invoiceDate       DateTime      @default(now()) @map("invoice_date") @db.Timestamptz(6)
  subtotal          Decimal       @default(0) @db.Decimal(18, 4)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)
  promotionDiscount Decimal       @default(0) @map("promotion_discount") @db.Decimal(18, 4)
  voucherCode       String?       @map("voucher_code") @db.VarChar(50)
  externalRef       String?       @map("external_ref") @db.VarChar(100)
  imported          Boolean       @default(false)
  pointsEarned      Decimal       @default(0) @map("points_earned") @db.Decimal(18, 2)
  pointsRedeemed    Decimal       @default(0) @map("points_redeemed") @db.Decimal(18, 2)
  pointsValue       Decimal       @default(0) @map("points_value") @db.Decimal(18, 4)
  taxAmount         Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount       Decimal       @default(0) @map("total_amount") @db.Decimal(18, 4)
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 4)
  costTotal         Decimal       @default(0) @map("cost_total") @db.Decimal(18, 4)
  returnedAmount    Decimal       @default(0) @map("returned_amount") @db.Decimal(18, 4)
  note              String?       @db.VarChar(1000)
  version           Int           @default(1)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById     String?       @map("cancelled_by_id") @db.Uuid
  cancelReason      String?       @map("cancel_reason") @db.VarChar(500)
  createdById       String?       @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch             @relation(fields: [branchId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  customer        Customer?          @relation(fields: [customerId], references: [id])
  shift           Shift?             @relation(fields: [shiftId], references: [id])
  seller          User?              @relation("InvoiceSeller", fields: [sellerId], references: [id])
  lines           InvoiceLine[]
  returns         SalesReturn[]      @relation("ReturnOfInvoice")
  exchangeReturns SalesReturn[]      @relation("ExchangeInvoice")
  promotions      InvoicePromotion[]
  salesOrder      SalesOrder?
  deliveries      Delivery[]

  @@unique([tenantId, code])
  @@index([tenantId, status, invoiceDate])
  @@index([tenantId, branchId, invoiceDate])
  @@index([tenantId, customerId, invoiceDate])
  @@index([tenantId, sellerId, invoiceDate])
  @@index([tenantId, shiftId])
  @@map("invoices")
}

/// quantity is in the selling unit; baseQuantity = quantity × conversionFactor is what leaves stock.
model InvoiceLine {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  invoiceId         String  @map("invoice_id") @db.Uuid
  lineNo            Int     @map("line_no")
  variantId         String  @map("variant_id") @db.Uuid
  batchId           String? @map("batch_id") @db.Uuid
  productUnitId     String? @map("product_unit_id") @db.Uuid
  unitName          String? @map("unit_name") @db.VarChar(50)
  conversionFactor  Decimal @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  quantity          Decimal @db.Decimal(18, 3)
  baseQuantity      Decimal @map("base_quantity") @db.Decimal(18, 3)
  returnedQuantity  Decimal @default(0) @map("returned_quantity") @db.Decimal(18, 3)
  listPrice         Decimal @map("list_price") @db.Decimal(18, 4)
  unitPrice         Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  promotionDiscount Decimal @default(0) @map("promotion_discount") @db.Decimal(18, 4)
  promotionId       String? @map("promotion_id") @db.Uuid
  isGift            Boolean @default(false) @map("is_gift")
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal         Decimal @map("line_total") @db.Decimal(18, 4)
  unitCost          Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)
  costTotal         Decimal @default(0) @map("cost_total") @db.Decimal(18, 4)
  note              String? @db.VarChar(500)

  invoice     Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  batch       ProductBatch?     @relation(fields: [batchId], references: [id])
  returnLines SalesReturnLine[]

  @@index([tenantId, invoiceId])
  @@index([tenantId, variantId])
  @@map("invoice_lines")
}

// =====================================================================
// SALES RETURNS / EXCHANGES (Module 07)
// =====================================================================

enum ReturnCondition {
  RESTOCK
  DAMAGED
}

/// Phiếu trả hàng bán: references a COMPLETED invoice; refund via phiếu chi, or left as customer credit (ledger); exchange links a new invoice.
model SalesReturn {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  warehouseId       String        @map("warehouse_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  shiftId           String?       @map("shift_id") @db.Uuid
  exchangeInvoiceId String?       @map("exchange_invoice_id") @db.Uuid
  code              String        @db.VarChar(50)
  status            InvoiceStatus @default(DRAFT)
  returnDate        DateTime      @default(now()) @map("return_date") @db.Timestamptz(6)
  reason            String?       @db.VarChar(200)
  note              String?       @db.VarChar(1000)
  subtotal          Decimal       @default(0) @db.Decimal(18, 4)
  feeAmount         Decimal       @default(0) @map("fee_amount") @db.Decimal(18, 4)
  totalRefund       Decimal       @default(0) @map("total_refund") @db.Decimal(18, 4)
  refundedAmount    Decimal       @default(0) @map("refunded_amount") @db.Decimal(18, 4)
  restockValue      Decimal       @default(0) @map("restock_value") @db.Decimal(18, 4)
  damagedValue      Decimal       @default(0) @map("damaged_value") @db.Decimal(18, 4)
  version           Int           @default(1)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById     String?       @map("cancelled_by_id") @db.Uuid
  cancelReason      String?       @map("cancel_reason") @db.VarChar(500)
  createdById       String?       @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [id])
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  invoice         Invoice           @relation("ReturnOfInvoice", fields: [invoiceId], references: [id])
  exchangeInvoice Invoice?          @relation("ExchangeInvoice", fields: [exchangeInvoiceId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  lines           SalesReturnLine[]

  @@unique([tenantId, code])
  @@index([tenantId, status, returnDate])
  @@index([tenantId, invoiceId])
  @@index([tenantId, customerId, returnDate])
  @@map("sales_returns")
}

model SalesReturnLine {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  returnId         String          @map("return_id") @db.Uuid
  lineNo           Int             @map("line_no")
  invoiceLineId    String          @map("invoice_line_id") @db.Uuid
  variantId        String          @map("variant_id") @db.Uuid
  batchId          String?         @map("batch_id") @db.Uuid
  unitName         String?         @map("unit_name") @db.VarChar(50)
  conversionFactor Decimal         @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  quantity         Decimal         @db.Decimal(18, 3)
  baseQuantity     Decimal         @map("base_quantity") @db.Decimal(18, 3)
  unitPrice        Decimal         @map("unit_price") @db.Decimal(18, 4)
  lineTotal        Decimal         @map("line_total") @db.Decimal(18, 4)
  condition        ReturnCondition @default(RESTOCK)
  unitCost         Decimal         @default(0) @map("unit_cost") @db.Decimal(18, 4)
  costTotal        Decimal         @default(0) @map("cost_total") @db.Decimal(18, 4)
  note             String?         @db.VarChar(500)

  return      SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine    @relation(fields: [invoiceLineId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([tenantId, returnId])
  @@index([tenantId, variantId])
