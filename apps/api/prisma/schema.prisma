  @@id([priceBookId, variantId, minQuantity])
  @@map("price_book_items")
}

model PriceBookBranch {
  priceBookId String    @map("price_book_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([priceBookId, branchId])
  @@map("price_book_branches")
}

// =====================================================================
// INVENTORY CORE
// =====================================================================

/// Current quantity per warehouse / variant / (batch). available = onHand - reserved.
/// batchKey is '' when batchId is null so the composite unique constraint is enforceable.
model StockBalance {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  batchId     String?  @map("batch_id") @db.Uuid
  batchKey    String   @default("") @map("batch_key") @db.VarChar(36)
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 3)
  reserved    Decimal  @default(0) @db.Decimal(18, 3)
  incoming    Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  batch     ProductBatch?  @relation(fields: [batchId], references: [id])

  @@unique([tenantId, warehouseId, variantId, batchKey])
  @@index([tenantId, variantId])
  @@index([tenantId, warehouseId])
  @@map("stock_balances")
}

enum MovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  REVERSAL
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  STOCKTAKE
}

/// Append-only stock ledger. quantity is signed (+ in, − out). balanceAfter is the warehouse-level on-hand after this row.
model StockMovement {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  warehouseId  String       @map("warehouse_id") @db.Uuid
  variantId    String       @map("variant_id") @db.Uuid
  batchId      String?      @map("batch_id") @db.Uuid
  type         MovementType
  quantity     Decimal      @db.Decimal(18, 3)
  unitCost     Decimal      @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost    Decimal      @default(0) @map("total_cost") @db.Decimal(18, 4)
  balanceAfter Decimal      @map("balance_after") @db.Decimal(18, 3)
  documentType String       @map("document_type") @db.VarChar(50)
  documentId   String       @map("document_id") @db.Uuid
  documentCode String       @map("document_code") @db.VarChar(50)
  lineId       String?      @map("line_id") @db.Uuid
  reason       String?      @db.VarChar(50)
  note         String?      @db.VarChar(500)
  createdById  String?      @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  batch     ProductBatch?  @relation(fields: [batchId], references: [id])

  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, warehouseId, variantId, createdAt])
  @@index([tenantId, documentType, documentId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

/// Moving-average cost ledger (tenant-wide per variant). One row per movement that affects cost or quantity.
model CostLedgerEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  movementId    String   @map("movement_id") @db.Uuid
  quantityDelta Decimal  @map("quantity_delta") @db.Decimal(18, 3)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(18, 4)
  valueDelta    Decimal  @map("value_delta") @db.Decimal(18, 4)
  qtyBefore     Decimal  @map("qty_before") @db.Decimal(18, 3)
  qtyAfter      Decimal  @map("qty_after") @db.Decimal(18, 3)
  avgCostBefore Decimal  @map("avg_cost_before") @db.Decimal(18, 4)
  avgCostAfter  Decimal  @map("avg_cost_after") @db.Decimal(18, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([movementId])
  @@index([tenantId, variantId, createdAt])
  @@map("cost_ledger_entries")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model StockReservation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  warehouseId  String            @map("warehouse_id") @db.Uuid
  variantId    String            @map("variant_id") @db.Uuid
  batchId      String?           @map("batch_id") @db.Uuid
  quantity     Decimal           @db.Decimal(18, 3)
  status       ReservationStatus @default(ACTIVE)
  documentType String            @map("document_type") @db.VarChar(50)
  documentId   String            @map("document_id") @db.Uuid
  expiresAt    DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt   DateTime?         @map("released_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([tenantId, warehouseId, variantId, status])
  @@index([tenantId, documentType, documentId])
  @@map("stock_reservations")
}

enum InventoryDocType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum InventoryDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryDocument {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  branchId      String             @map("branch_id") @db.Uuid
  warehouseId   String             @map("warehouse_id") @db.Uuid
  code          String             @db.VarChar(50)
  type          InventoryDocType
  status        InventoryDocStatus @default(DRAFT)
  reason        String?            @db.VarChar(50)
  note          String?            @db.VarChar(1000)
  totalQuantity Decimal            @default(0) @map("total_quantity") @db.Decimal(18, 3)
  totalCost     Decimal            @default(0) @map("total_cost") @db.Decimal(18, 4)
  postedAt      DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedById    String?            @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledById String?            @map("cancelled_by_id") @db.Uuid
  cancelReason  String?            @map("cancel_reason") @db.VarChar(500)
  version       Int                @default(1)
  createdById   String?            @map("created_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch                  @relation(fields: [branchId], references: [id])
  warehouse Warehouse               @relation(fields: [warehouseId], references: [id])
  lines     InventoryDocumentLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@map("inventory_documents")
}

model InventoryDocumentLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  lineNo         Int      @map("line_no")
  variantId      String   @map("variant_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  // RECEIPT/ISSUE: positive quantity. ADJUSTMENT: signed delta (actual - system).
  quantity       Decimal  @db.Decimal(18, 3)
  systemQuantity Decimal? @map("system_quantity") @db.Decimal(18, 3)
  actualQuantity Decimal? @map("actual_quantity") @db.Decimal(18, 3)
  unitCost       Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost      Decimal  @default(0) @map("total_cost") @db.Decimal(18, 4)
  note           String?  @db.VarChar(500)

  document InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id])
  batch    ProductBatch?     @relation(fields: [batchId], references: [id])

  @@index([tenantId, documentId])
  @@index([tenantId, variantId])
  @@map("inventory_document_lines")
}

// =====================================================================
// PARTIES & FINANCE CORE (shared by purchasing – Module 04 – and payments/debt – Module 08)
// =====================================================================

enum PartyType {
  SUPPLIER
  CUSTOMER
}

model Supplier {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(300)
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(200)
  address     String?  @db.VarChar(500)
  taxCode     String?  @map("tax_code") @db.VarChar(50)
  contactName String?  @map("contact_name") @db.VarChar(200)
  note        String?  @db.VarChar(1000)
  groupName   String?  @map("group_name") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders   PurchaseOrder[]
  receipts PurchaseReceipt[]
  returns  PurchaseReturn[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@map("suppliers")
}

/// Cached running balance per party (positive = we owe the supplier / the customer owes us). Always equals Σ party_ledger_entries.amount.
model PartyBalance {
  tenantId  String    @map("tenant_id") @db.Uuid
  partyType PartyType @map("party_type")
  partyId   String    @map("party_id") @db.Uuid
  balance   Decimal   @default(0) @db.Decimal(18, 4)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, partyType, partyId])
  @@map("party_balances")
}

enum LedgerEntryType {
  PURCHASE
  PURCHASE_RETURN
  PAYMENT
  REFUND
  SALE
  SALE_RETURN
  RECEIPT
  ADJUSTMENT
  OPENING
  REVERSAL
}

/// Append-only debt ledger (BR-07). amount is signed: + increases the party balance, − decreases it.
model PartyLedgerEntry {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  partyType    PartyType       @map("party_type")
  partyId      String          @map("party_id") @db.Uuid
  branchId     String?         @map("branch_id") @db.Uuid
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(18, 4)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(18, 4)
  documentType String          @map("document_type") @db.VarChar(50)
  documentId   String          @map("document_id") @db.Uuid
  documentCode String          @map("document_code") @db.VarChar(50)
  note         String?         @db.VarChar(500)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, partyType, partyId, createdAt])
  @@index([tenantId, documentType, documentId])
  @@map("party_ledger_entries")
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  EWALLET
  OTHER
  OFFSET
  TRANSFER
  POINTS
}

enum PaymentStatus {
  POSTED
  CANCELLED
}

/// Cash in/out vouchers (phiếu thu / phiếu chi). Module 08 adds cash accounts & shift handover on top of this table.
model Payment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  branchId      String           @map("branch_id") @db.Uuid
  code          String           @db.VarChar(50)
  direction     PaymentDirection
  method        PaymentMethod    @default(CASH)
  partyType     PartyType?       @map("party_type")
  partyId       String?          @map("party_id") @db.Uuid
  shiftId       String?          @map("shift_id") @db.Uuid
  cashAccountId String?          @map("cash_account_id") @db.Uuid
  categoryId    String?          @map("category_id") @db.Uuid
  transferId    String?          @map("transfer_id") @db.Uuid
  amount        Decimal          @db.Decimal(18, 4)
  allocated     Decimal          @default(0) @db.Decimal(18, 4)
  paymentDate   DateTime         @default(now()) @map("payment_date") @db.Timestamptz(6)
  reference     String?          @db.VarChar(200)
  note          String?          @db.VarChar(1000)
  status        PaymentStatus    @default(POSTED)
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?          @map("cancel_reason") @db.VarChar(500)
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch              @relation(fields: [branchId], references: [id])
  shift       Shift?              @relation(fields: [shiftId], references: [id])
  cashAccount CashAccount?        @relation(fields: [cashAccountId], references: [id])
  category    PaymentCategory?    @relation(fields: [categoryId], references: [id])
  transfer    CashTransfer?       @relation(fields: [transferId], references: [id])
  allocations PaymentAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, shiftId])
  @@index([tenantId, cashAccountId, paymentDate])
  @@index([tenantId, partyType, partyId, paymentDate])
  @@index([tenantId, branchId, paymentDate])
  @@map("payments")
}

/// How much of a payment settles which document (BR-07: allocations, never ad-hoc totals).
model PaymentAllocation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  documentId   String   @map("document_id") @db.Uuid
  amount       Decimal  @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentType, documentId])
  @@map("payment_allocations")
}

// =====================================================================
// PURCHASING (Module 04)
// =====================================================================

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  warehouseId    String              @map("warehouse_id") @db.Uuid
  supplierId     String              @map("supplier_id") @db.Uuid
  code           String              @db.VarChar(50)
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now()) @map("order_date") @db.Timestamptz(6)
  expectedDate   DateTime?           @map("expected_date") @db.Timestamptz(6)
  note           String?             @db.VarChar(1000)
  subtotal       Decimal             @default(0) @db.Decimal(18, 4)
  discountAmount Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount      Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal             @default(0) @map("total_amount") @db.Decimal(18, 4)
  version        Int                 @default(1)
  confirmedAt    DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?             @map("cancel_reason") @db.VarChar(500)
  createdById    String?             @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  branch    Branch              @relation(fields: [branchId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     PurchaseOrderLine[]
  receipts  PurchaseReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  lineNo           Int     @map("line_no")
  variantId        String  @map("variant_id") @db.Uuid
  quantity         Decimal @db.Decimal(18, 3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 4)
  note             String? @db.VarChar(500)

  order        PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant        @relation(fields: [variantId], references: [id])
  receiptLines PurchaseReceiptLine[]

  @@index([tenantId, orderId])
  @@map("purchase_order_lines")
}

enum PurchaseDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum CostAllocationMethod {
  BY_VALUE
  BY_QUANTITY
}

model PurchaseReceipt {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  warehouseId       String            @map("warehouse_id") @db.Uuid
  supplierId        String            @map("supplier_id") @db.Uuid
  orderId           String?           @map("order_id") @db.Uuid
  code              String            @db.VarChar(50)
  status            PurchaseDocStatus @default(DRAFT)
  receiptDate       DateTime          @default(now()) @map("receipt_date") @db.Timestamptz(6)
  supplierInvoiceNo String?           @map("supplier_invoice_no") @db.VarChar(100)
  note              String?           @db.VarChar(1000)
  subtotal          Decimal           @default(0) @db.Decimal(18, 4)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount         Decimal           @default(0) @map("tax_amount") @db.Decimal(18, 4)
  landedCostTotal   Decimal           @default(0) @map("landed_cost_total") @db.Decimal(18, 4)
  totalAmount       Decimal           @default(0) @map("total_amount") @db.Decimal(18, 4)
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(18, 4)
  returnedAmount    Decimal           @default(0) @map("returned_amount") @db.Decimal(18, 4)
