// =====================================================================
// CASH BOOK / FUNDS (Module 08)
// =====================================================================

enum CashAccountType {
  CASH
  BANK
  EWALLET
}

/// Quỹ tiền: két tiền mặt theo chi nhánh, tài khoản ngân hàng, ví. Số dư = đầu kỳ + Σ thu − Σ chi (phiếu POSTED, trừ OFFSET).
model CashAccount {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  branchId       String?         @map("branch_id") @db.Uuid
  code           String          @db.VarChar(50)
  name           String          @db.VarChar(200)
  type           CashAccountType @default(CASH)
  bankName       String?         @map("bank_name") @db.VarChar(200)
  accountNumber  String?         @map("account_number") @db.VarChar(100)
  accountHolder  String?         @map("account_holder") @db.VarChar(200)
  openingBalance Decimal         @default(0) @map("opening_balance") @db.Decimal(18, 4)
  balance        Decimal         @default(0) @db.Decimal(18, 4)
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?              @relation(fields: [branchId], references: [id])
  payments           Payment[]
  transfersOut       CashTransfer[]       @relation("TransferFrom")
  transfersIn        CashTransfer[]       @relation("TransferTo")
  reconciliations    CashReconciliation[]
  bankGatewayConfigs BankGatewayConfig[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, type])
  @@map("cash_accounts")
}

/// Loại thu / chi khác (tiền điện, thuê mặt bằng, thu khác…) cho phiếu không gắn đối tác.
model PaymentCategory {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  direction PaymentDirection
  name      String           @db.VarChar(200)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, direction, name])
  @@map("payment_categories")
}

enum CashTransferStatus {
  POSTED
  CANCELLED
}

/// Chuyển quỹ / bàn giao ca: tiền từ quỹ A sang quỹ B (két → két sắt / ngân hàng), hạch toán bằng cặp phiếu chi/thu TRANSFER.
model CashTransfer {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  branchId      String             @map("branch_id") @db.Uuid
  code          String             @db.VarChar(50)
  fromAccountId String             @map("from_account_id") @db.Uuid
  toAccountId   String             @map("to_account_id") @db.Uuid
  amount        Decimal            @db.Decimal(18, 4)
  shiftId       String?            @map("shift_id") @db.Uuid
  kind          String             @default("TRANSFER") @db.VarChar(20)
  note          String?            @db.VarChar(1000)
  status        CashTransferStatus @default(POSTED)
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?            @map("cancel_reason") @db.VarChar(500)
  createdById   String?            @map("created_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromAccount CashAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   CashAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  payments    Payment[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, createdAt])
  @@map("cash_transfers")
}

/// Kiểm quỹ: số dư sổ sách vs số đếm thực tế tại thời điểm kiểm.
model CashReconciliation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  bookBalance    Decimal  @map("book_balance") @db.Decimal(18, 4)
  countedBalance Decimal  @map("counted_balance") @db.Decimal(18, 4)
  difference     Decimal  @db.Decimal(18, 4)
  note           String?  @db.VarChar(1000)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account CashAccount @relation(fields: [accountId], references: [id])

  @@index([tenantId, accountId, createdAt])
  @@map("cash_reconciliations")
}

// =====================================================================
// MODULE 03b – STOCK TRANSFERS & STOCKTAKES
// =====================================================================

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum ShortageAction {
  WRITE_OFF
  RETURN_TO_SOURCE
}

enum StocktakeStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

/// Phiếu chuyển kho: xuất kho nguồn (TRANSFER_OUT, đang chuyển) → kho đích nhận (TRANSFER_IN); chênh lệch = gửi − nhận.
model StockTransfer {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  code             String          @db.VarChar(50)
  fromBranchId     String          @map("from_branch_id") @db.Uuid
  fromWarehouseId  String          @map("from_warehouse_id") @db.Uuid
  toBranchId       String          @map("to_branch_id") @db.Uuid
  toWarehouseId    String          @map("to_warehouse_id") @db.Uuid
  status           TransferStatus  @default(DRAFT)
  note             String?         @db.VarChar(1000)
  totalQuantity    Decimal         @default(0) @map("total_quantity") @db.Decimal(18, 3)
  totalCost        Decimal         @default(0) @map("total_cost") @db.Decimal(18, 4)
  receivedQuantity Decimal         @default(0) @map("received_quantity") @db.Decimal(18, 3)
  shortageQuantity Decimal         @default(0) @map("shortage_quantity") @db.Decimal(18, 3)
  shortageValue    Decimal         @default(0) @map("shortage_value") @db.Decimal(18, 4)
  shortageAction   ShortageAction? @map("shortage_action")
  receiveNote      String?         @map("receive_note") @db.VarChar(1000)
  dispatchedAt     DateTime?       @map("dispatched_at") @db.Timestamptz(6)
  dispatchedById   String?         @map("dispatched_by_id") @db.Uuid
  receivedAt       DateTime?       @map("received_at") @db.Timestamptz(6)
  receivedById     String?         @map("received_by_id") @db.Uuid
  cancelledAt      DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledById    String?         @map("cancelled_by_id") @db.Uuid
  cancelReason     String?         @map("cancel_reason") @db.VarChar(500)
  version          Int             @default(1)
  createdById      String?         @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch    Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch      Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id])
  fromWarehouse Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, fromWarehouseId, createdAt])
  @@index([tenantId, toWarehouseId, createdAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  lineNo           Int      @map("line_no")
  variantId        String   @map("variant_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  quantity         Decimal  @db.Decimal(18, 3)
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(18, 3)
  unitCost         Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost        Decimal  @default(0) @map("total_cost") @db.Decimal(18, 4)
  note             String?  @db.VarChar(500)

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  batch    ProductBatch?  @relation(fields: [batchId], references: [id])

  @@index([tenantId, transferId])
  @@index([tenantId, variantId])
  @@map("stock_transfer_lines")
}

/// Phiếu kiểm kho: chụp tồn hệ thống khi thêm dòng, nhập số đếm (nhiều người), cân bằng → bút toán STOCKTAKE theo chênh lệch so với snapshot.
model Stocktake {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  branchId         String          @map("branch_id") @db.Uuid
  warehouseId      String          @map("warehouse_id") @db.Uuid
  code             String          @db.VarChar(50)
  status           StocktakeStatus @default(DRAFT)
  scope            String          @default("SELECTED") @db.VarChar(20)
  note             String?         @db.VarChar(1000)
  snapshotAt       DateTime        @default(now()) @map("snapshot_at") @db.Timestamptz(6)
  totalLines       Int             @default(0) @map("total_lines")
  countedLines     Int             @default(0) @map("counted_lines")
  increaseQuantity Decimal         @default(0) @map("increase_quantity") @db.Decimal(18, 3)
  decreaseQuantity Decimal         @default(0) @map("decrease_quantity") @db.Decimal(18, 3)
  increaseValue    Decimal         @default(0) @map("increase_value") @db.Decimal(18, 4)
  decreaseValue    Decimal         @default(0) @map("decrease_value") @db.Decimal(18, 4)
  uncountedAs      String?         @map("uncounted_as") @db.VarChar(10)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  completedById    String?         @map("completed_by_id") @db.Uuid
  cancelledAt      DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledById    String?         @map("cancelled_by_id") @db.Uuid
  cancelReason     String?         @map("cancel_reason") @db.VarChar(500)
  version          Int             @default(1)
  createdById      String?         @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch          @relation(fields: [branchId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  lines     StocktakeLine[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@map("stocktakes")
}

model StocktakeLine {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  stocktakeId     String    @map("stocktake_id") @db.Uuid
  variantId       String    @map("variant_id") @db.Uuid
  batchId         String?   @map("batch_id") @db.Uuid
  batchKey        String    @default("") @map("batch_key") @db.VarChar(36)
  systemQuantity  Decimal   @default(0) @map("system_quantity") @db.Decimal(18, 3)
  countedQuantity Decimal?  @map("counted_quantity") @db.Decimal(18, 3)
  deltaQuantity   Decimal   @default(0) @map("delta_quantity") @db.Decimal(18, 3)
  unitCost        Decimal   @default(0) @map("unit_cost") @db.Decimal(18, 4)
  deltaValue      Decimal   @default(0) @map("delta_value") @db.Decimal(18, 4)
  countedById     String?   @map("counted_by_id") @db.Uuid
  countedAt       DateTime? @map("counted_at") @db.Timestamptz(6)
  note            String?   @db.VarChar(500)

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  batch     ProductBatch?  @relation(fields: [batchId], references: [id])

  @@unique([stocktakeId, variantId, batchKey])
  @@index([tenantId, stocktakeId])
  @@index([tenantId, variantId])
  @@map("stocktake_lines")
}

// =====================================================================
// MODULE 09 – PROMOTIONS
// =====================================================================

enum PromotionType {
  INVOICE_DISCOUNT
  INVOICE_GIFT
  PRODUCT_DISCOUNT
  BUY_X_GET_Y
  VOUCHER
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
}

enum VoucherStatus {
  ACTIVE
  USED
  DISABLED
}

/// Chương trình khuyến mãi (BR-90..BR-96). `config` giữ điều kiện / phần thưởng theo `type` (được DTO kiểm tra).
model Promotion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  code             String          @db.VarChar(50)
  name             String          @db.VarChar(200)
  type             PromotionType
  status           PromotionStatus @default(ACTIVE)
  description      String?         @db.VarChar(1000)
  startsAt         DateTime?       @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?       @map("ends_at") @db.Timestamptz(6)
  daysOfWeek       Int[]           @default([]) @map("days_of_week")
  timeFrom         String?         @map("time_from") @db.VarChar(5)
  timeTo           String?         @map("time_to") @db.VarChar(5)
  customerGroups   String[]        @default([]) @map("customer_groups")
  priority         Int             @default(0)
  stackable        Boolean         @default(false)
  usageLimit       Int?            @map("usage_limit")
  usageCount       Int             @default(0) @map("usage_count")
  perCustomerLimit Int?            @map("per_customer_limit")
  config           Json
  createdById      String?         @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches PromotionBranch[]
  vouchers PromotionVoucher[]
  uses     InvoicePromotion[]

  @@unique([tenantId, code])
  @@index([tenantId, status, type])
  @@map("promotions")
}

model PromotionBranch {
  promotionId String    @map("promotion_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([promotionId, branchId])
  @@map("promotion_branches")
}

model PromotionVoucher {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  promotionId String        @map("promotion_id") @db.Uuid
  code        String        @db.VarChar(50)
  status      VoucherStatus @default(ACTIVE)
  maxUses     Int           @default(1) @map("max_uses")
  usedCount   Int           @default(0) @map("used_count")
  customerId  String?       @map("customer_id") @db.Uuid
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  note        String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  uses      InvoicePromotion[]

  @@unique([tenantId, code])
  @@index([tenantId, promotionId, status])
  @@map("promotion_vouchers")
}

/// Khuyến mãi đã áp dụng trên một hóa đơn (báo cáo, giới hạn lượt dùng, hoàn lượt khi hủy).
model InvoicePromotion {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  promotionId  String        @map("promotion_id") @db.Uuid
  voucherId    String?       @map("voucher_id") @db.Uuid
  type         PromotionType
  amount       Decimal       @default(0) @db.Decimal(18, 4)
  giftQuantity Decimal       @default(0) @map("gift_quantity") @db.Decimal(18, 3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  promotion Promotion         @relation(fields: [promotionId], references: [id])
  voucher   PromotionVoucher? @relation(fields: [voucherId], references: [id])

  @@index([tenantId, promotionId, createdAt])
  @@index([tenantId, invoiceId])
  @@map("invoice_promotions")
}

// =====================================================================
// MODULE 06 – SALES ORDERS & DELIVERY
// =====================================================================

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PICKING
  DELIVERING
  DELIVERED
  RETURNING
  RETURNED
  CANCELLED
}

/// Đơn đặt hàng (BR-100..BR-105): DRAFT → CONFIRMED (giữ tồn) → COMPLETED (chuyển thành hóa đơn) / CANCELLED.
model SalesOrder {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  warehouseId    String           @map("warehouse_id") @db.Uuid
  customerId     String?          @map("customer_id") @db.Uuid
  sellerId       String?          @map("seller_id") @db.Uuid
  priceBookId    String?          @map("price_book_id") @db.Uuid
  invoiceId      String?          @unique @map("invoice_id") @db.Uuid
  code           String           @db.VarChar(50)
  status         SalesOrderStatus @default(DRAFT)
  source         String           @default("POS") @db.VarChar(30)
  orderDate      DateTime         @default(now()) @map("order_date") @db.Timestamptz(6)
  expectedAt     DateTime?        @map("expected_at") @db.Timestamptz(6)
  note           String?          @db.VarChar(1000)
  subtotal       Decimal          @default(0) @db.Decimal(18, 4)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount      Decimal          @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal          @default(0) @map("total_amount") @db.Decimal(18, 4)
  depositAmount  Decimal          @default(0) @map("deposit_amount") @db.Decimal(18, 4)
  confirmedAt    DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelledById  String?          @map("cancelled_by_id") @db.Uuid
  cancelReason   String?          @map("cancel_reason") @db.VarChar(500)
  version        Int              @default(1)
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch           @relation(fields: [branchId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  customer  Customer?        @relation(fields: [customerId], references: [id])
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id])
  lines     SalesOrderLine[]
  delivery  Delivery?

  @@unique([tenantId, code])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, customerId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  lineNo           Int     @map("line_no")
  variantId        String  @map("variant_id") @db.Uuid
  batchId          String? @map("batch_id") @db.Uuid
  productUnitId    String? @map("product_unit_id") @db.Uuid
  unitName         String? @map("unit_name") @db.VarChar(50)
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  quantity         Decimal @db.Decimal(18, 3)
  baseQuantity     Decimal @map("base_quantity") @db.Decimal(18, 3)
  listPrice        Decimal @default(0) @map("list_price") @db.Decimal(18, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 4)
  note             String? @db.VarChar(500)

  order   SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
  batch   ProductBatch?  @relation(fields: [batchId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, variantId])
  @@map("sales_order_lines")
}

/// Vận đơn giao hàng (BR-106..BR-108) gắn với đơn đặt hàng và/hoặc hóa đơn.
model Delivery {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  code          String         @db.VarChar(50)
  orderId       String?        @unique @map("order_id") @db.Uuid
  invoiceId     String?        @map("invoice_id") @db.Uuid
  customerId    String?        @map("customer_id") @db.Uuid
  status        DeliveryStatus @default(PENDING)
  receiverName  String         @map("receiver_name") @db.VarChar(200)
  receiverPhone String?        @map("receiver_phone") @db.VarChar(30)
  address       String         @db.VarChar(500)
  ward          String?        @db.VarChar(100)
  district      String?        @db.VarChar(100)
  province      String?        @db.VarChar(100)
  carrier       String?        @db.VarChar(100)
  trackingCode  String?        @map("tracking_code") @db.VarChar(100)
  shippingFee   Decimal        @default(0) @map("shipping_fee") @db.Decimal(18, 4)
  shippingCost  Decimal        @default(0) @map("shipping_cost") @db.Decimal(18, 4)
  codAmount     Decimal        @default(0) @map("cod_amount") @db.Decimal(18, 4)
  codCollected  Boolean        @default(false) @map("cod_collected")
  weightGram    Int?           @map("weight_gram")
  note          String?        @db.VarChar(1000)
  expectedAt    DateTime?      @map("expected_at") @db.Timestamptz(6)
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id])
  order    SalesOrder?     @relation(fields: [orderId], references: [id])
  invoice  Invoice?        @relation(fields: [invoiceId], references: [id])
  customer Customer?       @relation(fields: [customerId], references: [id])
  events   DeliveryEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, invoiceId])
  @@map("deliveries")
}

model DeliveryEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId  String         @map("delivery_id") @db.Uuid
  status      DeliveryStatus
  note        String?        @db.VarChar(500)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

// =====================================================================
// MODULE 13 – INTEGRATIONS & DATA MIGRATION
// =====================================================================

enum ImportJobStatus {
  PREVIEW
  RUNNING
  DONE
  FAILED
}

/// Một lần nhập dữ liệu (Excel KiotViet hoặc KiotViet Public API): xem trước → xác nhận → kết quả/đối soát (BR-130..BR-134).
model ImportJob {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  type        String          @db.VarChar(30)
  source      String          @default("EXCEL") @db.VarChar(30)
  status      ImportJobStatus @default(PREVIEW)
  fileName    String?         @map("file_name") @db.VarChar(255)
  headers     Json?
  mapping     Json?
  options     Json?
  payload     Json?
  rowCount    Int             @default(0) @map("row_count")
  totals      Json?
  errors      Json?
  startedAt   DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?       @map("finished_at") @db.Timestamptz(6)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("import_jobs")
}

/// Kết nối phần mềm ngoài (KiotViet Public API): thông tin do người dùng tự nhập, secret mã hóa AES-256-GCM.
model IntegrationConnection {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  provider   String    @db.VarChar(30)
  retailer   String?   @db.VarChar(100)
  clientId   String?   @map("client_id") @db.VarChar(200)
  secretEnc  String?   @map("secret_enc") @db.VarChar(1000)
  status     String    @default("DISCONNECTED") @db.VarChar(20)
  branchMap  Json?     @map("branch_map")
  lastTestAt DateTime? @map("last_test_at") @db.Timestamptz(6)
  lastSyncAt DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastError  String?   @map("last_error") @db.VarChar(1000)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("integration_connections")
}

// =====================================================================
// THANH TOÁN CHUYỂN KHOẢN TỰ ĐỘNG (SePay)
// =====================================================================

/// Cấu hình cổng nhận tiền chuyển khoản (SePay): tài khoản nhận, quỹ ghi sổ, tiền tố mã thanh toán, khóa webhook (chỉ lưu hash).
model BankGatewayConfig {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  provider        String    @default("SEPAY") @db.VarChar(20)
  enabled         Boolean   @default(false)
  bankCode        String?   @map("bank_code") @db.VarChar(40)
  accountNumber   String?   @map("account_number") @db.VarChar(40)
  accountName     String?   @map("account_name") @db.VarChar(120)
  cashAccountId   String?   @map("cash_account_id") @db.Uuid
  codePrefix      String    @default("BA") @map("code_prefix") @db.VarChar(5)
  posTtlMinutes   Int       @default(15) @map("pos_ttl_minutes")
  webhookKeyHash  String?   @unique @map("webhook_key_hash") @db.VarChar(64)
  webhookKeyLast4 String?   @map("webhook_key_last4") @db.VarChar(4)
  lastWebhookAt   DateTime? @map("last_webhook_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])

  @@unique([tenantId, provider])
  @@map("bank_gateway_configs")
}

enum BankRequestPurpose {
  POS
  INVOICE
  SALES_ORDER
}

enum BankRequestStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

/// Yêu cầu thanh toán chuyển khoản: một mã (vd BA12345678) để khách ghi vào nội dung chuyển khoản / quét VietQR.
/// POS: tiền về → POS hoàn tất hóa đơn với phiếu thu BANK_TRANSFER (usedAmount). INVOICE / SALES_ORDER: tiền về → hệ thống tự lập phiếu thu.
model BankTransferRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  code          String             @db.VarChar(20)
  purpose       BankRequestPurpose
  status        BankRequestStatus  @default(PENDING)
  branchId      String             @map("branch_id") @db.Uuid
  documentId    String?            @map("document_id") @db.Uuid
  documentCode  String?            @map("document_code") @db.VarChar(50)
  customerId    String?            @map("customer_id") @db.Uuid
  amount        Decimal            @db.Decimal(18, 4)
  paidAmount    Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 4)
  usedAmount    Decimal            @default(0) @map("used_amount") @db.Decimal(18, 4)
  cashAccountId String?            @map("cash_account_id") @db.Uuid
  bankCode      String             @map("bank_code") @db.VarChar(40)
  accountNumber String             @map("account_number") @db.VarChar(40)
  accountName   String?            @map("account_name") @db.VarChar(120)
  note          String?            @db.VarChar(500)
  createdById   String             @map("created_by_id") @db.Uuid
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  paidAt        DateTime?          @map("paid_at") @db.Timestamptz(6)
  consumedAt    DateTime?          @map("consumed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id])
  createdBy    User              @relation("BankRequestCreatedBy", fields: [createdById], references: [id])
  transactions BankTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, documentId])
  @@map("bank_transfer_requests")
}

/// Giao dịch ngân hàng nhận qua webhook (SePay). Duy nhất theo (tenant, provider, externalId) → webhook gửi lặp không ghi trùng.
/// status: MATCHED (khớp yêu cầu) · UNMATCHED (chưa khớp, chờ xử lý tay) · APPLIED (đã gắn tay vào chứng từ) · IGNORED (tiền ra / khác tài khoản / bỏ qua)
model BankTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  provider        String    @default("SEPAY") @db.VarChar(20)
  externalId      String    @map("external_id") @db.VarChar(64)
  gateway         String?   @db.VarChar(60)
  accountNumber   String?   @map("account_number") @db.VarChar(40)
  subAccount      String?   @map("sub_account") @db.VarChar(40)
  transferType    String    @map("transfer_type") @db.VarChar(5)
  amount          Decimal   @db.Decimal(18, 4)
  accumulated     Decimal?  @db.Decimal(18, 4)
  content         String?   @db.VarChar(1000)
  code            String?   @db.VarChar(60)
  referenceCode   String?   @map("reference_code") @db.VarChar(120)
  description     String?   @db.VarChar(1000)
  transactionDate DateTime  @map("transaction_date") @db.Timestamptz(6)
  raw             Json
  status          String    @default("UNMATCHED") @db.VarChar(20)
  requestId       String?   @map("request_id") @db.Uuid
  paymentId       String?   @map("payment_id") @db.Uuid
  matchNote       String?   @map("match_note") @db.VarChar(500)
  handledById     String?   @map("handled_by_id") @db.Uuid
  handledAt       DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request BankTransferRequest? @relation(fields: [requestId], references: [id])

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, status, createdAt])
  @@map("bank_transactions")
}

// =====================================================================
// MODULE 11 – LOYALTY
// =====================================================================

enum PointEntryType {
  EARN
  REDEEM
  ADJUST
  REVERSAL
  EXPIRE
}

/// Sổ điểm tích lũy (BR-140..BR-144): append-only, số dư cache ở customers.points.
model CustomerPointEntry {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  customerId   String         @map("customer_id") @db.Uuid
  type         PointEntryType
  points       Decimal        @db.Decimal(18, 2)
  balanceAfter Decimal        @map("balance_after") @db.Decimal(18, 2)
  documentType String?        @map("document_type") @db.VarChar(50)
  documentId   String?        @map("document_id") @db.Uuid
  documentCode String?        @map("document_code") @db.VarChar(50)
  note         String?        @db.VarChar(500)
  createdById  String?        @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, documentType, documentId])
  @@map("customer_point_entries")
}

// =====================================================================
// MODULE 11 – EMPLOYEES (commission, attendance)
// =====================================================================

enum CommissionBasis {
  REVENUE
  GROSS_PROFIT
  QUANTITY
}

/// Quy tắc hoa hồng (BR-150): theo nhân viên / tất cả, theo nhóm hàng hoặc hàng hóa, % trên doanh thu thuần hoặc lợi nhuận gộp, hoặc tiền / đơn vị.
model CommissionRule {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  name       String          @db.VarChar(200)
  userId     String?         @map("user_id") @db.Uuid
  categoryId String?         @map("category_id") @db.Uuid
  variantId  String?         @map("variant_id") @db.Uuid
  basis      CommissionBasis @default(REVENUE)
  rate       Decimal         @db.Decimal(18, 4)
  minRevenue Decimal         @default(0) @map("min_revenue") @db.Decimal(18, 4)
  priority   Int             @default(0)
  isActive   Boolean         @default(true) @map("is_active")
  startsAt   DateTime?       @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime?       @map("ends_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("commission_rules")
}

/// Chấm công (BR-151): một lượt vào/ra của nhân viên tại chi nhánh.
model Attendance {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  branchId   String?   @map("branch_id") @db.Uuid
  checkInAt  DateTime  @default(now()) @map("check_in_at") @db.Timestamptz(6)
  checkOutAt DateTime? @map("check_out_at") @db.Timestamptz(6)
  minutes    Int?
  source     String    @default("APP") @db.VarChar(20)
  note       String?   @db.VarChar(500)
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  editedById String?   @map("edited_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, checkInAt])
  @@index([tenantId, checkInAt])
  @@map("attendances")
}
